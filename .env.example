# Copy to .env and adjust. Never commit .env.
# Real secrets for deployed environments belong in the platform's secret store, not here.

# --- Kafka / ZooKeeper (Confluent Platform 7.x still supports ZooKeeper) ---
CP_VERSION=7.7.1
# Hostname clients outside Docker use to reach Kafka. Set to the server's DNS name when deployed.
KAFKA_ADVERTISED_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
KAFKA_REPLICATION_FACTOR=1
# Keep false outside local dev; create topics explicitly.
KAFKA_AUTO_CREATE_TOPICS=false

# --- api service ---
PORT=8080
# Inside Docker: kafka:29092. Running api on the host: localhost:9092.
KAFKA_BROKERS=kafka:29092
# Host port the dev override publishes the api on.
API_PORT=8080

# --- k6 ---
K6_BASE_URL=http://api:8080
